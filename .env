# LLM provider: ollama (default, local) or openai
LLM_PROVIDER=ollama

# Ollama (local) - used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI-compatible - used when LLM_PROVIDER=openai
OPENAI_API_KEY= Enter your OpenAI API key here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# MySQL credentials/config
MYSQL_HOST=localhost
MYSQL_PORT=3306 - Enter your MySQL port number here if it's different from the default 3306
MYSQL_USER=root
MYSQL_PASSWORD=YourPasswordHere
MYSQL_DATABASE=tcs_forecast

# App
DATA_DIR=./data
CHROMA_DIR=./data/chroma
LOG_LEVEL=INFO
